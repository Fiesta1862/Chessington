<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0C0A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual Board — deterministic mode"
            android:textColor="#39FF6B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#C8DACF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/last_move"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#7FA88D"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/fen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#16221A"
            android:inputType="text"
            android:padding="8dp"
            android:textColor="#39FF6B"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_load"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Load FEN" />

            <Button
                android:id="@+id/btn_white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Play White" />

            <Button
                android:id="@+id/btn_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Play Black" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:columnCount="8"
            android:rowCount="8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear tap" />

            <Button
                android:id="@+id/btn_calibrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calibrate board" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
